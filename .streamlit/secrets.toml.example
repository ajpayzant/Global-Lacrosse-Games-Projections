# Streamlit Cloud -> App settings -> Secrets. Enables saving overrides, results, box scores and snapshots
# to a private GitHub Gist (Streamlit Cloud's own disk is wiped on every restart / redeploy).
# 1. Create a SECRET gist at https://gist.github.com with one file named overrides.json containing {}
# 2. Create a fine-grained or classic token with only the "gist" scope
GLG_GIST_ID = "your-gist-id"
GLG_GITHUB_TOKEN = "ghp_or_github_pat_..."
