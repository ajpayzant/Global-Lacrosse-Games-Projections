# Allow-list: only what the deployed app and the results Action need is committed.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/run_glg_app.bat
!/.streamlit/
/.streamlit/*
!/.streamlit/config.toml
!/.streamlit/secrets.toml.example
!/.github/
!/app/
!/glg/
!/scripts/
/scripts/*
!/scripts/scrape_glg_live.py
!/scripts/migrate_to_gist.py
!/warehouse/
/warehouse/*
!/warehouse/sixes.duckdb
!/warehouse/README.md
!/data/
/data/*
!/data/glg/
/data/glg/*
!/data/glg/glg_mens_schedule.csv
!/data/glg/worlds_2023_games.csv
!/data/glg/worlds_2023_rosters.csv
!/data/glg/README_glg.md
!/data/glg/README_worlds2023.md
!/reports/
/reports/*
!/reports/model_guide.md
!/reports/calibration_v3.md
!/reports/eda_findings.md
# never commit
__pycache__/
*.pyc
